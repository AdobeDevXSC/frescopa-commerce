# Copy to demo/.env (gitignored). Never commit real values.

# Adobe Commerce Optimizer: OAuth Server-to-Server credential with the
# "Adobe Commerce Optimizer Ingestion" API (Adobe Developer Console).
ACO_CLIENT_ID=
ACO_CLIENT_SECRET=
# From the instance access URLs in Commerce Cloud Manager:
# https://{region}[-sandbox].api.commerce.adobe.com/{tenantId}/v1/catalog
ACO_TENANT_ID=
ACO_REGION=na1
ACO_ENVIRONMENT=sandbox

# Document Authoring (da.live) site holding /products and /commerce/settings
DA_ORG=adobedevxsc
DA_SITE=frescopa-commerce
# IMS token for admin.da.live (aem-edge-delivery-services:da-auth skill, or copy from da.live)
DA_TOKEN=
