{
  "name": "frescopa-demo-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Demo-kit tooling: validate DA structured product content and sync it to an Adobe Commerce Optimizer tenant.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node bin/validate.mjs",
    "sync": "node bin/sync.mjs",
    "verify": "node bin/verify.mjs",
    "reset": "node bin/reset.mjs",
    "seed:push": "node bin/seed-push.mjs",
    "seed:from-live": "node bin/seed-from-live.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "cd .. && npx eslint --ext .mjs,.cjs demo"
  },
  "dependencies": {
    "@adobe-commerce/aco-ts-sdk": "2.0.0",
    "@adobe/da-sc-sdk": "0.5.0",
    "dotenv": "16.4.7"
  }
}
